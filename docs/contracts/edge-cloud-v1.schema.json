        "job_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "message_id": {"$ref": "#/$defs/id"},
        "action": {"$ref": "#/$defs/request_action"},
        "producer": {"const": "service"}
      },
      "required": ["protocol_version", "kind", "job_id", "job_revision", "message_id", "action", "producer"],
      "additionalProperties": false
    },
    "evidence_receipt": {
      "type": "object",
      "properties": {
        "protocol_version": {"const": 1},
        "kind": {"const": "evidence_receipt"},
        "job_id": {"$ref": "#/$defs/id"},
        "job_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "message_id": {"$ref": "#/$defs/id"},
        "request_message_id": {"$ref": "#/$defs/id"},
        "status": {"enum": ["ready", "insufficient", "unsupported", "stale", "rejected", "budget_exceeded"]},
        "scope": {"$ref": "#/$defs/scope"},
        "scope_sha256": {"$ref": "#/$defs/sha256"},
        "evidence": {"type": "array", "items": {"$ref": "#/$defs/evidence"}, "minItems": 0, "maxItems": 12},
        "missing_channels": {
          "type": "array",
          "items": {"enum": ["flow_translation", "flow_rotation", "flow_scale", "gimbal_yaw", "gimbal_pitch", "gimbal_roll"]},
          "minItems": 0,
          "maxItems": 6,
          "uniqueItems": true
        },
        "reason_codes": {
          "type": "array",
          "items": {
            "enum": ["MISSING_CHANNEL", "LOW_COVERAGE", "UNSUPPORTED_TIMING", "UNSUPPORTED_MODALITY", "SCOPE_OUTSIDE_ASSET", "SOURCE_CHANGED", "STALE_REVISION", "BUDGET_EXCEEDED", "NO_EVIDENCE", "INVALID_REQUEST"]
          },
          "minItems": 0,
          "maxItems": 10,
          "uniqueItems": true
        },
        "producer": {"const": "client"}
      },
      "required": ["protocol_version", "kind", "job_id", "job_revision", "message_id", "request_message_id", "status", "scope", "scope_sha256", "evidence", "missing_channels", "reason_codes", "producer"],
      "additionalProperties": false,
      "allOf": [{"if": {"properties": {"status": {"const": "ready"}}, "required": ["status"]}, "then": {"properties": {"evidence": {"minItems": 1}}}}]
    },
    "edit_proposal": {
      "type": "object",
      "properties": {
        "protocol_version": {"const": 1},
        "kind": {"const": "edit_proposal"},
        "job_id": {"$ref": "#/$defs/id"},
        "job_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "message_id": {"$ref": "#/$defs/id"},
        "proposal_id": {"$ref": "#/$defs/id"},
        "music_asset_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "music_source_revision": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "output": {"$ref": "#/$defs/output"},
        "shots": {"type": "array", "items": {"$ref": "#/$defs/shot"}, "minItems": 1, "maxItems": 512},
