            "SOURCE_TOO_SHORT",
            "ACTIVITY_FAILED",
            "TURNBACK_DETECTED",
            "SCALE_REVERSAL",
            "PLAYBACK_UNSUPPORTED",
            "ORDER_CONFLICT",
            "ADJACENT_ROTATION",
            "PHOTO_CROP_CONFLICT",
