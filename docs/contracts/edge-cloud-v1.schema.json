      "additionalProperties": false
    },
    "validation_receipt": {
      "type": "object",
      "properties": {
        "protocol_version": {"const": 1},
        "kind": {"const": "validation_receipt"},
        "job_id": {"$ref": "#/$defs/id"},
        "job_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "message_id": {"$ref": "#/$defs/id"},
        "proposal_message_id": {"$ref": "#/$defs/id"},
        "proposal_id": {"$ref": "#/$defs/id"},
        "proposal_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"enum": ["valid", "invalid", "insufficient", "stale", "needs_review"]},
        "local_receipt_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "compiled_plan_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "validated_scopes": {"type": "array", "items": {"$ref": "#/$defs/validated_scope"}, "minItems": 0, "maxItems": 512},
        "checks": {"type": "array", "items": {"$ref": "#/$defs/check"}, "minItems": 0, "maxItems": 8192},
        "violations": {"type": "array", "items": {"$ref": "#/$defs/violation"}, "minItems": 0, "maxItems": 512},
        "report_only": {"const": true},
        "producer": {"const": "client"}
      },
      "required": [
        "protocol_version",
        "kind",
        "job_id",
        "job_revision",
        "message_id",
        "proposal_message_id",
        "proposal_id",
        "proposal_sha256",
        "status",
        "local_receipt_id",
        "compiled_plan_sha256",
        "validated_scopes",
        "checks",
        "violations",
        "report_only",
        "producer"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "valid"}}, "required": ["status"]},
          "then": {
            "properties": {
              "compiled_plan_sha256": {"$ref": "#/$defs/sha256"},
              "violations": {"maxItems": 0},
              "checks": {"minItems": 1, "items": {"properties": {"status": {"enum": ["pass", "not_applicable"]}}}},
              "local_receipt_id": {"$ref": "#/$defs/id"}
            }
          }
        }
      ],
      "description": "Client-produced report only. Schema cannot authenticate sender or prove local receipt existence. needs_review leaves semantic checks unresolved."
    },
    "frame_request_limits": {
      "type": "object",
      "properties": {
        "max_bytes": {"type": "integer", "minimum": 1, "maximum": 1572864},
