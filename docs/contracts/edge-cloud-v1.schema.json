        "local_evaluation_ref": {"$ref": "#/$defs/id"}
      },
      "required": ["shot_id", "scope", "scope_sha256", "local_evaluation_ref"],
      "additionalProperties": false
    },
    "manifest": {
      "type": "object",
      "properties": {
        "protocol_version": {"const": 1},
        "kind": {"const": "manifest"},
        "job_id": {"$ref": "#/$defs/id"},
        "job_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "message_id": {"$ref": "#/$defs/id"},
        "stage": {"enum": ["estimate", "planning", "review"]},
        "assets": {"type": "array", "items": {"$ref": "#/$defs/asset"}, "minItems": 1, "maxItems": 512},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/candidate"}, "minItems": 0, "maxItems": 2048},
        "music": {"anyOf": [{"$ref": "#/$defs/music"}, {"type": "null"}]},
        "output": {"$ref": "#/$defs/output"},
        "ruleset_id": {"$ref": "#/$defs/id"},
        "ruleset_revision": {"$ref": "#/$defs/id"},
        "analyzer_id": {"$ref": "#/$defs/id"},
        "analyzer_revision": {"$ref": "#/$defs/id"},
        "policy": {"$ref": "#/$defs/policy"},
        "budgets": {"$ref": "#/$defs/budgets"},
        "producer": {"const": "client"}
      },
      "required": ["protocol_version", "kind", "job_id", "job_revision", "message_id", "stage", "assets", "candidates", "music", "output", "ruleset_id", "ruleset_revision", "analyzer_id", "analyzer_revision", "policy", "budgets", "producer"],
      "additionalProperties": false
