            "OUTPUT_GAP_OR_OVERLAP",
            "STALE_REVISION",
            "BUDGET_EXCEEDED"
          ]
        },
        "shot_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]},
        "evidence_ref": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}
      },
      "required": ["code", "shot_id", "evidence_ref"],
      "additionalProperties": false
    },
    "validated_scope": {
      "type": "object",
      "properties": {
        "shot_id": {"$ref": "#/$defs/id"},
